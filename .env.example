# Bootstrap user (cmd/seed only; not used by the runtime auth path)
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_USER_NAME=
BOOTSTRAP_USER_ROLE=admin

# cmd/seed bootstrap helper only (historical Supabase Auth admin API)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
