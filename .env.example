APP_HOST=127.0.0.1
APP_PORT=8080

DATABASE_URL=

# Central authentication
AUTH_ACCESS_TOKEN_SECRET=

SUPABASE_URL=

# Recommended keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy fallback
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap user
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_USER_NAME=
BOOTSTRAP_USER_ROLE=admin

# Central Supabase password recovery
PASSWORD_RECOVERY_REDIRECT_URL=https://sso.bp3kpsumatera2.com/reset-password
# Local development example:
# PASSWORD_RECOVERY_REDIRECT_URL=http://127.0.0.1:8080/reset-password

# Browser SSO (disabled unless explicitly enabled)
SSO_BROWSER_ENABLED=false
# Base64-encoded 32-byte AES key. Never commit a real value.
SSO_BROWSER_SESSION_KEY=
SSO_BROWSER_COOKIE_SECURE=true
SSO_BROWSER_COOKIE_SAME_SITE=Lax
SSO_BROWSER_SESSION_TTL=8h
SSO_AUTHORIZATION_CODE_TTL=3m
SSO_SILAPET_CLIENT_ID=silapet-web
SSO_SILAPET_APPLICATION_CODE=silapet
SSO_SILAPET_REDIRECT_URIS=http://localhost:8081/auth/sso/callback
SSO_SILAPET_POST_LOGOUT_REDIRECT_URIS=http://localhost:8081/login
PORTAL_SILAPET_LAUNCH_URL=http://127.0.0.1:5173/
SSO_KLINIK_CLIENT_ID=klinik-pkp-web
SSO_KLINIK_APPLICATION_CODE=klinik_pkp
SSO_KLINIK_REDIRECT_URIS=http://localhost:3000/auth/sso/callback
SSO_KLINIK_POST_LOGOUT_REDIRECT_URIS=http://localhost:3000/login
PORTAL_KLINIK_LAUNCH_URL=http://localhost:3000/
